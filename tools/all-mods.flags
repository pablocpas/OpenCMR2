# The --all-mods launch preset, one argument per line. @MODS@ is the owned car ZIP folder and
# @PRESET@ the test preset. Shared by rebuild.sh and the macOS app launcher; keep the order.
--asset-upgrades
--trees
shell
--tree-wind
on
--spectators
animated
--driver-names
real
--cars
205-finland-1986,subaru-spain-1996,fabia-redbull,lancer-finland-2001
--mods-dir
@MODS@
--roads
finland1
--effect
temporal_aa=off
--effect
spatial_aa=on
--effect
metalfx_spatial=on
--effect
volumetric_clouds=off
--effect
dust_plume=on
--effect
dust_volume=on
--effect
body_dirt=on
--effect
bloom=off
--effect
particles=off
--effect
shadows=on
--effect
god_rays=on
--effect
color_grading=off
--effect
motion_blur=off
--effect
depth_of_field=off
--test-preset
@PRESET@
--speed-hold
0
--effect
vapor_trails=on
--effect
speed_lines=off
--speed-fov
100
--tire-debris
200
--tire-track-length
1000
--tire-track-history
8
--drone-distance
50
--sun-glare
60
--camera-roll
30
--speed-fov-cockpit
25
--tunnel-vision
130
--tunnel-lines
1
--brush-volume
1
